# Local development values. On Vercel set these in Project Settings -> Environment Variables
# (they are inlined into the browser bundle at build time, so redeploy after changing them).
# NEXT_PUBLIC_API_URL must be the Render API URL in production; there is no localhost fallback.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADI_TOKEN_ADDRESS=
NEXT_PUBLIC_ADI_ROUTER_ADDRESS=
NEXT_PUBLIC_ADI_SUBSCRIPTION_MANAGER_ADDRESS=
NEXT_PUBLIC_POLYGON_TOKEN_ADDRESS=
NEXT_PUBLIC_POLYGON_ROUTER_ADDRESS=
NEXT_PUBLIC_POLYGON_SUBSCRIPTION_MANAGER_ADDRESS=
