# Backend environment variables (copy to .env and fill in real values for local dev)
# Never commit actual secrets. Use placeholders here only.

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=mysql://user:password@localhost:3306/gateway

# JWT
# Generate a strong secret (32+ chars): openssl rand -base64 32
JWT_SECRET=development-only-change-this-secret-before-deploying

# CORS
# Comma-separated list of allowed origins (e.g. https://stablecoin-merchant-payment-gateway.vercel.app,http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Chain RPC URLs
ADI_TESTNET_RPC_URL=https://rpc.ab.testnet.adifoundation.ai/
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# Chain contract addresses (set these for the networks you use)
ADI_TESTNET_TOKEN_ADDRESS=
ADI_TESTNET_PAYMENT_ROUTER_ADDRESS=
ADI_TESTNET_SUBSCRIPTION_MANAGER_ADDRESS=
ADI_TESTNET_PRIVATE_KEY=

POLYGON_AMOY_TOKEN_ADDRESS=
POLYGON_AMOY_PAYMENT_ROUTER_ADDRESS=
POLYGON_AMOY_SUBSCRIPTION_MANAGER_ADDRESS=
POLYGON_AMOY_PRIVATE_KEY=

# Webhook
WEBHOOK_SECRET=

# Frontend URL (for payment links)
FRONTEND_URL=http://localhost:3000

# Privy (Google Sign-In + embedded wallet verification)
# Get your App ID and App Secret from the Privy dashboard: https://dashboard.privy.io/
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Privy API base URL for server-side verification key fetch and user/wallet lookup (default: https://auth.privy.io)
PRIVY_API_URL=
# The Privy verification key is fetched automatically from GET /api/v1/apps/${PRIVY_APP_ID}
# (the AppConfig "verification_key" field). No separate JWKS URL is needed.

# Default chain
DEFAULT_CHAIN=adi-testnet

# Log level
LOG_LEVEL=info